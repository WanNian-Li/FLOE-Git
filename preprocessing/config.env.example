# Illustrative environment settings. Do not put credentials in this file.
# PowerShell: $env:FLOE_PREPROCESS_ROOT = 'D:/FLOE_data'
# bash: export FLOE_PREPROCESS_ROOT=/path/to/FLOE_data
FLOE_PREPROCESS_ROOT=/path/to/FLOE_data
FLOE_GPT_PATH=/path/to/snap/bin/gpt
FLOE_GPT_XMX=10G
FLOE_GPT_CACHE=5G
FLOE_GPT_THREADS=8
FLOE_CHART_REGION=CapeFarewell
FLOE_DELETE_ZIP=0
FLOE_DELETE_SAR_SOURCE=0
# Default class sets for make_labels.py (explicit values shown for clarity):
FLOE_KEEP_CLASSES=0,1,2,3,4,5
FLOE_TARGET_CLASSES=1,2,3,4,5
# Existing statistics for append-only normalization:
FLOE_NORM_MODE=apply
FLOE_STATS_JSON=/path/to/zscore_stats.json
